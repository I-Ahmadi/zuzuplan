generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                     String    @id @default(cuid())
  email                  String    @unique
  password               String
  name                   String
  avatar                 String?
  emailVerified          Boolean   @default(false)
  emailVerificationToken String?
  passwordResetToken     String?
  passwordResetExpires   DateTime?
  passwordChangedAt      DateTime?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt

  refreshTokens          RefreshToken[]
  ownedProjects          Project[]        @relation("ProjectOwner")
  projectMembers         ProjectMember[]
  createdTasks           Task[]           @relation("TaskCreator")
  assignedTasks          Task[]           @relation("TaskAssignee")
  createdDocs            ProjectDoc[]
  comments               Comment[]
  attachments            Attachment[]
  sentProjectInvites     ProjectInvite[]  @relation("ProjectInviteInviter")
  acceptedProjectInvites ProjectInvite[]  @relation("ProjectInviteAcceptedBy")
  preferences            UserPreference?
  activityEvents         ActivityEvent[]  @relation("ActivityActor")
  inboxItems             InboxItem[]
  ownedIdeas             IdeaWorkspace[]  @relation("IdeaOwner")
  ideaMemberships        IdeaMember[]
  updatedIdeaSections    IdeaSection[]    @relation("IdeaSectionUpdater")
  ownedIdeaExperiments   IdeaExperiment[] @relation("IdeaExperimentOwner")
  ideaComments           IdeaComment[]
  ideaVersions           IdeaVersion[]    @relation("IdeaVersionCreator")
}

model UserPreference {
  id                      String   @id @default(cuid())
  userId                  String   @unique
  defaultView             String   @default("board")
  density                 String   @default("comfortable")
  theme                   String   @default("system")
  profileNote             String   @default("")
  sidebarDefault          String   @default("expanded")
  projectSelectorBehavior String   @default("remember")
  rememberLastSpace       Boolean  @default(true)
  emailNotifications      Boolean  @default(true)
  inAppNotifications      Boolean  @default(true)
  dueSoonNotifications    Boolean  @default(true)
  assignmentNotifications Boolean  @default(true)
  mentionNotifications    Boolean  @default(true)
  commentNotifications    Boolean  @default(true)
  digestFrequency         String   @default("daily")
  quietHoursEnabled       Boolean  @default(false)
  quietHoursStart         String   @default("18:00")
  quietHoursEnd           String   @default("09:00")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        String   @id @default(cuid())
  token     String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model Project {
  id          String    @id @default(cuid())
  name        String
  key         String // max 10 chars in app
  description String?
  ownerId     String
  status      String    @default("active") // active | archived | completed
  visibility  String    @default("private") // private | public
  startDate   DateTime?
  endDate     DateTime?
  progress    Int       @default(0) // 0-100
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members        ProjectMember[]
  tasks          Task[]
  sprints        Sprint[]
  docs           ProjectDoc[]
  invites        ProjectInvite[]
  activityEvents ActivityEvent[]
  inboxItems     InboxItem[]
  pullRequests   PullRequest[]
  deployments    Deployment[]
  convertedIdeas IdeaWorkspace[] @relation("ConvertedIdeaProject")

  @@unique([ownerId, key])
  @@index([ownerId])
  @@index([status])
}

model IdeaWorkspace {
  id                 String   @id @default(cuid())
  title              String
  summary            String?
  problem            String?
  opportunity        String?
  stage              String   @default("CAPTURED")
  confidence         Int      @default(25)
  tags               String[] @default([])
  ownerId            String
  convertedProjectId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  owner            User              @relation("IdeaOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  convertedProject Project?          @relation("ConvertedIdeaProject", fields: [convertedProjectId], references: [id], onDelete: SetNull)
  members          IdeaMember[]
  sections         IdeaSection[]
  experiments      IdeaExperiment[]
  requirements     IdeaRequirement[]
  goals            IdeaGoal[]
  comments         IdeaComment[]
  versions         IdeaVersion[]
  conversions      IdeaConversion[]
  links            IdeaLink[]

  @@index([ownerId])
  @@index([convertedProjectId])
  @@index([stage])
  @@index([updatedAt])
}

model IdeaMember {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  role      String   @default("Employee")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idea IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  user User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([ideaId, userId])
  @@index([ideaId])
  @@index([userId])
}

model IdeaSection {
  id          String   @id @default(cuid())
  ideaId      String
  type        String   @default("NOTE")
  title       String
  contentJson Json?
  plainText   String   @default("")
  order       Int      @default(0)
  updatedById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  idea      IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  updatedBy User?         @relation("IdeaSectionUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  comments  IdeaComment[]

  @@index([ideaId])
  @@index([type])
  @@index([updatedById])
  @@index([updatedAt])
}

model IdeaExperiment {
  id         String    @id @default(cuid())
  ideaId     String
  title      String
  hypothesis String?
  method     String?
  status     String    @default("PLANNED")
  result     String?
  evidence   String?
  ownerId    String?
  dueDate    DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  idea  IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  owner User?         @relation("IdeaExperimentOwner", fields: [ownerId], references: [id], onDelete: SetNull)

  @@index([ideaId])
  @@index([ownerId])
  @@index([status])
  @@index([dueDate])
}

model IdeaRequirement {
  id              String   @id @default(cuid())
  ideaId          String
  type            String   @default("REQUIREMENT")
  title           String
  description     String?
  priority        String   @default("MEDIUM")
  acceptanceNotes String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  idea IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([type])
  @@index([priority])
}

model IdeaGoal {
  id        String   @id @default(cuid())
  ideaId    String
  title     String
  metric    String?
  target    String?
  status    String   @default("ACTIVE")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  idea IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([status])
}

model IdeaComment {
  id         String    @id @default(cuid())
  ideaId     String
  sectionId  String?
  userId     String
  parentId   String?
  content    String
  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  idea    IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  section IdeaSection?  @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  IdeaComment?  @relation("IdeaCommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies IdeaComment[] @relation("IdeaCommentThread")

  @@index([ideaId])
  @@index([sectionId])
  @@index([userId])
  @@index([parentId])
  @@index([createdAt])
}

model IdeaVersion {
  id           String   @id @default(cuid())
  ideaId       String
  label        String
  snapshotJson Json
  createdById  String
  createdAt    DateTime @default(now())

  idea      IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)
  createdBy User          @relation("IdeaVersionCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([createdById])
  @@index([createdAt])
}

model IdeaConversion {
  id                 String   @id @default(cuid())
  ideaId             String
  projectId          String
  conversionPlanJson Json
  createdById        String
  createdAt          DateTime @default(now())

  idea IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([projectId])
  @@index([createdById])
}

model IdeaLink {
  id          String   @id @default(cuid())
  ideaId      String
  targetType  String
  targetId    String?
  url         String?
  title       String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  idea IdeaWorkspace @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([targetType])
  @@index([targetId])
}

model ProjectInvite {
  id           String    @id @default(cuid())
  projectId    String
  email        String
  role         String    @default("Employee") // Admin | Manager | Employee | Viewer
  tokenHash    String    @unique
  status       String    @default("PENDING") // PENDING | ACCEPTED | REVOKED | EXPIRED
  invitedById  String
  acceptedById String?
  expiresAt    DateTime
  acceptedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy  User    @relation("ProjectInviteInviter", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy User?   @relation("ProjectInviteAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([email])
  @@index([status])
  @@index([expiresAt])
}

model ProjectDoc {
  id          String   @id @default(cuid())
  title       String
  content     String   @default("")
  projectId   String
  createdById String
  pinned      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy User    @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdById])
  @@index([pinned])
}

model ProjectMember {
  id        String   @id @default(cuid())
  projectId String
  userId    String
  role      String   @default("Employee") // Admin | Manager | Employee | Viewer
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
}

model Task {
  id            String    @id @default(cuid())
  title         String
  description   String?
  projectId     String
  assigneeId    String?
  createdById   String
  sprintId      String?
  type          String    @default("FEATURE") // BUG, FEATURE, CHORE, TECH_DEBT, SPIKE, INCIDENT
  priority      String    @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  status        String    @default("BACKLOG") // BACKLOG, READY, IN_PROGRESS, IN_REVIEW, READY_TO_MERGE, MERGED, DEPLOYED, DONE, BLOCKED, CANCELED
  estimate      Int?
  branchName    String?
  blockedReason String?
  readyAt       DateTime?
  mergedAt      DateTime?
  deployedAt    DateTime?
  backlogOrder  Float     @default(0)
  sprintOrder   Float     @default(0)
  dueDate       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sprint         Sprint?         @relation(fields: [sprintId], references: [id], onDelete: SetNull)
  assignee       User?           @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy      User            @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  subtasks       Subtask[]
  comments       Comment[]
  attachments    Attachment[]
  linkedFrom     TaskLink[]      @relation("TaskLinksFrom")
  linkedTo       TaskLink[]      @relation("TaskLinksTo")
  activityEvents ActivityEvent[]
  inboxItems     InboxItem[]
  pullRequests   PullRequest[]
  deployments    Deployment[]

  @@index([projectId])
  @@index([sprintId])
  @@index([assigneeId])
  @@index([createdById])
  @@index([type])
  @@index([status])
  @@index([priority])
  @@index([updatedAt])
}

model TaskLink {
  id           String   @id @default(cuid())
  sourceTaskId String
  targetTaskId String
  type         String   @default("RELATES_TO")
  createdAt    DateTime @default(now())

  sourceTask Task @relation("TaskLinksFrom", fields: [sourceTaskId], references: [id], onDelete: Cascade)
  targetTask Task @relation("TaskLinksTo", fields: [targetTaskId], references: [id], onDelete: Cascade)

  @@unique([sourceTaskId, targetTaskId, type])
  @@index([sourceTaskId])
  @@index([targetTaskId])
}

model Sprint {
  id        String    @id @default(cuid())
  name      String
  goal      String?
  status    String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED
  projectId String
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@index([status])
}

model Subtask {
  id        String   @id @default(cuid())
  taskId    String
  title     String
  completed Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

model Comment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([userId])
}

model Attachment {
  id         String   @id @default(cuid())
  taskId     String
  fileName   String
  fileUrl    String
  fileType   String
  fileSize   Int
  uploadedBy String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [uploadedBy], references: [id], onDelete: Cascade)

  @@index([taskId])
  @@index([uploadedBy])
}

model ActivityEvent {
  id           String   @id @default(cuid())
  projectId    String?
  taskId       String?
  actorId      String?
  targetUserId String?
  type         String
  entityType   String
  entityId     String
  title        String
  description  String?
  severity     String   @default("INFO") // INFO, SUCCESS, WARNING, CRITICAL
  metadata     Json?
  createdAt    DateTime @default(now())

  project    Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task       Task?       @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actor      User?       @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  inboxItems InboxItem[]

  @@index([projectId])
  @@index([taskId])
  @@index([actorId])
  @@index([targetUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model InboxItem {
  id              String    @id @default(cuid())
  userId          String
  projectId       String?
  taskId          String?
  activityEventId String?
  type            String
  title           String
  description     String?
  priority        String    @default("NORMAL") // LOW, NORMAL, HIGH, URGENT
  status          String    @default("UNREAD") // UNREAD, READ, ARCHIVED
  actionUrl       String?
  source          String?
  readAt          DateTime?
  archivedAt      DateTime?
  snoozedUntil    DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task          Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  activityEvent ActivityEvent? @relation(fields: [activityEventId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model PullRequest {
  id           String    @id @default(cuid())
  projectId    String
  taskId       String?
  provider     String    @default("MANUAL")
  repository   String
  number       Int
  title        String
  url          String?
  branch       String?
  targetBranch String?
  status       String    @default("OPEN") // OPEN, CLOSED, MERGED, DRAFT
  reviewState  String    @default("REQUESTED") // REQUESTED, APPROVED, CHANGES_REQUESTED, MERGED
  ciStatus     String    @default("UNKNOWN") // UNKNOWN, PENDING, SUCCESS, FAILED
  author       String?
  openedAt     DateTime?
  mergedAt     DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  deployments Deployment[]

  @@unique([projectId, provider, repository, number])
  @@index([projectId])
  @@index([taskId])
  @@index([status])
  @@index([reviewState])
  @@index([ciStatus])
}

model Deployment {
  id            String    @id @default(cuid())
  projectId     String
  taskId        String?
  pullRequestId String?
  environment   String    @default("staging") // production, staging, preview
  status        String    @default("PENDING") // PENDING, RUNNING, SUCCESS, FAILED, ROLLED_BACK
  version       String?
  url           String?
  deployedBy    String?
  deployedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project     Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  task        Task?        @relation(fields: [taskId], references: [id], onDelete: SetNull)
  pullRequest PullRequest? @relation(fields: [pullRequestId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([taskId])
  @@index([environment])
  @@index([status])
  @@index([deployedAt])
}
