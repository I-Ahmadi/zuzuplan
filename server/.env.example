# Database (PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"

# Server
PORT=3000
NODE_ENV=development

# Client (CORS + email links)
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173

# JWT
JWT_SECRET=your-access-token-secret
JWT_REFRESH_SECRET=your-refresh-token-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_MS=604800000

# Email (Nodemailer)
EMAIL_DEV_MODE=true
# EMAIL_HOST=smtp.example.com
# EMAIL_PORT=587
# EMAIL_SECURE=false
# EMAIL_USER=
# EMAIL_PASS=
# EMAIL_FROM=noreply@example.com

# Optional: Firebase for real-time
# FIREBASE_PROJECT_ID=
# FIREBASE_PRIVATE_KEY=
# FIREBASE_CLIENT_EMAIL=

# GitHub integration
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_WEBHOOK_SECRET=
# GITHUB_APP_NAME=sprintly
# GitHub OAuth callback URL: http://localhost:3000/api/auth/github/callback

# Uploads
UPLOAD_DIR=./uploads
AVATAR_MAX_FILE_SIZE=2097152
